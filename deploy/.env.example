# Set a published sha-<full commit> tag or image digest before starting.
TRUSTED_ROUTER_IMAGE=ghcr.io/attestx/trusted-data-router:sha-REPLACE
TRUSTED_ROUTER_ISSUER=gateway-issuer
TRUSTED_ROUTER_ID=relay-a
TRUSTED_ROUTER_FLEET_URL=https://fleet.example/
TRUSTED_ROUTER_CONFIG=/etc/trusted-data-router
TRUSTED_ROUTER_STATE=/var/lib/trusted-data-router
TRUSTED_ROUTER_TLS=/etc/trusted-data-router-tls
TRUSTED_ROUTER_UID=10001
TRUSTED_ROUTER_GID=10001
TRUSTED_ROUTER_BIND=0.0.0.0
TRUSTED_ROUTER_PORT=443
# For a private Fleet CA, place fleet-ca.pem in TRUSTED_ROUTER_CONFIG:
# TRUSTED_ROUTER_FLEET_CA_FILE=/etc/router/fleet-ca.pem
# Exact browser origins, comma separated; empty disables cross-origin access.
TRUSTED_ROUTER_ORIGINS=
